{
  "name": "voxagent",
  "version": "0.1.0",
  "description": "Voice-powered terminal agent. Fully offline. Speak commands, get answers.",
  "bin": {
    "voxagent": "./bin/voxagent.js"
  },
  "scripts": {
    "start": "node bin/voxagent.js",
    "test": "node --test test/unit/arguments.test.js test/unit/capture.test.js test/unit/decibri-interface.test.js test/unit/download.test.js test/unit/exit-paths.test.js test/unit/file.test.js test/unit/packaging.test.js test/unit/startup.test.js test/unit/stt.test.js test/unit/whisper.test.js",
    "test:integration": "node --test test/integration/file.test.js test/integration/network.test.js test/integration/pipeline.test.js test/integration/transcription.test.js"
  },
  "keywords": [
    "voice",
    "cli",
    "llm",
    "speech-to-text",
    "microphone",
    "ollama",
    "terminal",
    "voice-agent",
    "decibri",
    "agent",
    "whisper",
    "offline",
    "local",
    "privacy"
  ],
  "author": "Analytics in Motion",
  "files": [
    "bin/",
    "lib/",
    "README.md",
    "LICENSE",
    "ATTRIBUTION.md"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/analyticsinmotion/voxagent.git"
  },
  "homepage": "https://voxagent.run",
  "engines": {
    "node": "^18.3.0 || ^20 || >=21"
  },
  "dependencies": {
    "@kutalia/whisper-node-addon": "^1.0.0",
    "decibri": "^5.7.0",
    "ollama": "^0.5.0"
  }
}
